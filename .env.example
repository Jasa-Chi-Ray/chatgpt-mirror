# 服务
PORT=40002
TZ=Asia/Shanghai
ALL_IN_ONE_IMAGE=lisa666520/chatgpt-mirror-django:all-in-one

# 必填凭据（请生成随机高强度值，禁止直接使用示例值）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
GATEWAY_ADMIN_SECRET=
DJANGO_SECRET_KEY=
CREDENTIAL_ENCRYPTION_KEY=

# Django 与 Cookie 安全
DJANGO_DEBUG=false
DJANGO_ALLOW_ALL_ORIGINS=disable
DJANGO_ALLOWED_HOSTS=example.com,django,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SESSION_COOKIE_SECURE=true
DJANGO_CSRF_COOKIE_SECURE=true
COOKIE_SECURE=true
API_TOKEN_TTL_SECONDS=604800

# 用户与界面
ALLOW_REGISTER=false
FREE_ACCOUNT_USERNAME=free_account
MIRROR_API_PREFIX=

# Turnstile：仅支持 enable 或 disable
CLOUDFLARE_TURNSTILE=disable
CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=

# 上游地址
ADMIN_UPSTREAM=
CHATGPT_BASE_URL=https://chatgpt.com
CHATGPT_CDN_BASE_URL=https://cdn.oaistatic.com
CHATGPT_AB_BASE_URL=https://ab.chatgpt.com

# cfbypass
CF_BYPASS_PROXY_SERVER=
CF_BYPASS_USER_AGENT="Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/151.0.0.0 Safari/537.36"
CF_BYPASS_HEADLESS=true
# 单次导航后获取 Cookie 的总等待上限
CF_BYPASS_MAX_WAIT_SECONDS=20
CF_BYPASS_PAGE_LOAD_TIMEOUT_SECONDS=15
# 首次无 Cookie 的日志提示时间；不会提前结束，总截止时间以上一项为准
CF_BYPASS_FIRST_COOKIE_WAIT_SECONDS=6
CF_BYPASS_POLL_INTERVAL_SECONDS=0.5
CF_BYPASS_COOKIE_STABLE_POLLS=2
CF_BYPASS_NAVIGATION_RETRIES=1
CF_BYPASS_ELEMENT_LOOKUP_TIMEOUT_SECONDS=0.2
CF_BYPASS_DISPLAY_SIZE=1920x1080
CF_BYPASS_ALLOWED_HOSTS=chatgpt.com,.chatgpt.com

# Gateway 与 all-in-one
REQUEST_TIMEOUT_SECS=180
STARTUP_TIMEOUT_SECONDS=60
RUST_LOG=info
