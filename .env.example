# ============================================================
# 服务与云端镜像
# ============================================================

BIND_ADDRESS=0.0.0.0
PORT=40002
TZ=Asia/Shanghai

# Docker 自动选择 AMD64 或 ARM64。
GATEWAY_IMAGE=lisa666520/chatgpt-mirror:latest
BACKEND_IMAGE=lisa666520/chatgpt-mirror:backend
CFBYPASS_IMAGE=lisa666520/chatgpt-mirror:cfbypass


# ============================================================
# 管理员与服务密钥
# ============================================================

ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# 以下三个密钥首次部署时分别生成，使用不同的随机值。
# 可以分别执行 openssl rand -hex 32。
# 已有部署沿用原值。
GATEWAY_ADMIN_SECRET=
DJANGO_SECRET_KEY=
CREDENTIAL_ENCRYPTION_KEY=

# CREDENTIAL_ENCRYPTION_KEY 至少 32 个字符。
# 它用于解密已有数据库中的上游凭据，更新部署时不要更换。


# ============================================================
# 访问方式与 Cookie
# ============================================================

# 本机或局域网 HTTP：enable
# 域名及 HTTPS：disable
#
# enable 会自动关闭 Secure Cookie，适配本地 HTTP。
# disable 时使用下面的域名、来源和 Secure Cookie 配置。
LOCAL_NETWORK_ACCESS=enable

DJANGO_DEBUG=false
DJANGO_ALLOW_ALL_ORIGINS=disable

# 使用域名及 HTTPS 时，将 example.com 替换为实际域名。
# DJANGO_ALLOWED_HOSTS 填主机名，不带协议。
# 多个主机或来源使用英文逗号分隔。
DJANGO_ALLOWED_HOSTS=example.com,django,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com

DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SESSION_COOKIE_SECURE=true
DJANGO_CSRF_COOKIE_SECURE=true
COOKIE_SECURE=true

# 本地登录会话有效期，单位为秒，默认 7 天。
API_TOKEN_TTL_SECONDS=604800

# 管理服务请求网关的连接及读取超时，单位为秒。
GATEWAY_CONNECT_TIMEOUT_SECONDS=5
GATEWAY_READ_TIMEOUT_SECONDS=60


# ============================================================
# 反向代理与来源 IP
# ============================================================

# 内置 Cloudflare 网段。
# 使用其他反向代理时，填写实际代理 IP 或 CIDR。
# 多个值使用英文逗号分隔，直连访问时留空。
# 仅添加实际代理，不填写所有地址或整个私有网段。
#
# NGINX Proxy Manager 需要同时透传：
# Host、X-Forwarded-For、X-Forwarded-Proto。
TRUSTED_PROXY_IPS=


# ============================================================
# 用户与界面
# ============================================================

ALLOW_REGISTER=false
FREE_ACCOUNT_USERNAME=free_account

# 项目 GitHub 链接展示配置，不是 GitHub OAuth。
SHOW_GITHUB=true

MIRROR_API_PREFIX=


# ============================================================
# Linux DO OAuth
# ============================================================

# 默认关闭。
# 必须手动改为 enable 才开启。
# 仅填写 Client ID、Client Secret 不会自动开启。
LINUXDO_OAUTH_ENABLED=disable

LINUXDO_CLIENT_ID=
LINUXDO_CLIENT_SECRET=
LINUXDO_REDIRECT_URI=

# 最低论坛信任等级，支持 0、1、2、3、4。
LINUXDO_MIN_TRUST_LEVEL=0

# 回调地址必须与 Linux DO Connect 应用登记值完全一致。
# 浏览器访问本站的协议、主机和端口也必须与回调地址一致。
#
# 本地 HTTP 示例，需要 LOCAL_NETWORK_ACCESS=enable：
# LINUXDO_REDIRECT_URI=http://127.0.0.1:40002/0x/user/oauth/linuxdo/callback
#
# 公网 HTTPS 示例：
# LINUXDO_REDIRECT_URI=https://example.com/0x/user/oauth/linuxdo/callback
#
# ALLOW_REGISTER=false：
# 首次授权后验证现有镜像账号，再绑定并登录，管理员账号同样支持。
#
# ALLOW_REGISTER=true：
# 未绑定的 Linux DO 身份自动注册为普通镜像用户并绑定。
# 新用户不会获得管理员权限，需要管理员为其分配可用号池。
#
# 已绑定账号后续直接通过 Linux DO 登录。


# ============================================================
# Cloudflare Turnstile
# ============================================================

# enable 或 disable。
CLOUDFLARE_TURNSTILE=disable
CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=


# ============================================================
# 上游服务与云端 DIL
# ============================================================

# 留空时使用镜像内置的管理前端。
ADMIN_UPSTREAM=

CHATGPT_BASE_URL=https://chatgpt.com
CHATGPT_CDN_BASE_URL=https://cdn.oaistatic.com
CHATGPT_AB_BASE_URL=https://ab.chatgpt.com


# ============================================================
# CF 辅助
# ============================================================

# 可选代理地址；代理用户名和密码需要进行 URL 编码。
CF_BYPASS_PROXY_SERVER=

CF_BYPASS_USER_AGENT="Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/146.0.0.0 Safari/537.36"
CF_BYPASS_ACCEPT_LANGUAGE=zh-CN,zh

CF_BYPASS_BROWSER_IDLE_SECONDS=30
CF_BYPASS_MAX_WAIT_SECONDS=20
# 包含自动化链接所需的官网认证页和认证资源域名。
CF_BYPASS_ALLOWED_HOSTS=chatgpt.com,.chatgpt.com,auth.openai.com,sentinel.openai.com,auth-cdn.oaistatic.com,cdn.auth0.com


# ============================================================
# 网关
# ============================================================

REQUEST_TIMEOUT_SECS=180
CURL_IMPERSONATE_PROFILE=chrome146
RUST_LOG=warn
